  "resolved_findings": [
    {
      "finding_id": "P017-V1-CORRECTNESS-001",
      "resolution": "Remove the predecessor spool. Execution performs one full validation pass before credential presence and one final combined projection pass after all provider requests, with no predecessor reconstruction at any transport boundary. A 16 GiB free-space reservation explicitly covers the 4 GiB remaining-response ceiling, 8 GiB canonical projection ceiling, and 4 GiB metadata, atomic-publication, derived-evidence, and safety margin."
    },
    {
      "finding_id": "P017-SEC-001",
      "resolution": "Freeze exact Program 017 private terminal, public terminal, and pass-lineage schemas, static values, branch semantics, forbidden fields, canonical byte projection, atomic publication, and recovery controls."
    },
    {
      "finding_id": "P017-SEC-002",
      "resolution": "Freeze exact credential ordering and failure semantics plus runtime-before-child Git topology and exact child binding requirements."
    },
    {
      "finding_id": "P017-V1-STATE-001",
      "resolution": "Durable state identifies v1 as a rejected proposal and v2 as the current prospective proposal."
    },
    {
      "finding_id": "P017-V2-CORRECTNESS-001",
      "resolution": "Freeze general Program 017 no-reissue-after-intent and ambiguous-transport consumed semantics plus every retained-result retry prohibition and fault regression."
    },
    {
      "finding_id": "P017-V2-CORRECTNESS-002",
      "resolution": "Bind the first Program 017 intent to the privately rederived request immediately after the discarded partial session, including exact index, page one, null incoming token, request identity, and URL."
    },
    {
      "finding_id": "P017-V2-CORRECTNESS-003",
      "resolution": "Constrain public observed_at to the terminal-closeout instant as the sole public timestamp and add a provenance regression."
    },
    {
      "finding_id": "P017-V2-SEC-001",
      "resolution": "Require type(value) is int and exact zero for both private strategy counters, with boolean-rejection regressions."
    },
    {
      "finding_id": "P017-V2-DOC-001",
      "resolution": "Remove the stale spool-descriptor requirement from Program 017 documentation."
    },
    {
      "finding_id": "P017-V3-CORRECTNESS-001",
      "resolution": "Separate immutable predecessor-root and lock-file metadata from the intentionally mutable Program 017 root. Refresh the mutable root's expected full tuple only after each authorized create-only write and parent fsync while retaining stable identity, ownership, and mode checks."
    }
  ],
