  "policy": {
    "sequence": [
      "The disposition query assigns every one of the 1,219 parent configurations a stage and outcome.",
      "Every complete fixed-block identity must pass every visible-base gate across the three fixed blocks.",
      "Every base survivor must pass every complete same-strategy, same-commit fixed-block identity that differs in exactly one parameter.",
      "A neighbor survivor must pass both full-range execution stresses.",
      "Only a complete survivor may enter the simultaneously frozen final cohort before any controlled result is inspected."
    ],
    "visible_base": {
      "candidate_set": "all 84 strategy, parameter, and code-commit identities with completed Normal rows for all three fixed blocks",
      "required": "all gates",
      "gates": [
        {
          "metric": "validation_fold_count",
          "aggregation": "count of listed fixed blocks",
          "comparison": ">=",
          "threshold": "3"
        },
        {
          "metric": "positive_validation_fold_rate",
          "aggregation": "positive total-return blocks divided by listed fixed blocks",
          "comparison": ">=",
          "threshold": "1"
        },
        {
          "metric": "fixed_weight_benchmark_win_rate",
          "aggregation": "blocks with candidate total return greater than fixed-weight total return divided by listed fixed blocks",
          "comparison": ">=",
          "threshold": "0.6666666666666666666666666667"
        },
        {
          "metric": "worst_validation_return",
          "aggregation": "minimum block total_return",
          "comparison": ">=",
          "threshold": "0"
        },
        {
          "metric": "worst_validation_sharpe",
          "aggregation": "minimum block sharpe_ratio",
          "comparison": ">=",
          "threshold": "0.5"
        },
        {
          "metric": "max_validation_drawdown",
          "aggregation": "maximum block max_drawdown",
          "comparison": "<=",
          "threshold": "0.20"
        },
        {
          "metric": "max_average_gross_exposure",
          "aggregation": "maximum block average_gross_exposure",
          "comparison": "<=",
          "threshold": "1"
        },
        {
          "metric": "max_top_5_session_profit_share",
          "aggregation": "maximum block top_5_session_profit_share",
          "comparison": "<=",
          "threshold": "0.25"
        },
        {
          "metric": "max_top_instrument_profit_share",
          "aggregation": "maximum block top_instrument_profit_share",
          "comparison": "<=",
          "threshold": "0.50"
        },
        {
          "metric": "max_turnover",
          "aggregation": "maximum block turnover",
          "comparison": "<=",
          "threshold": "30"
        },
        {
          "metric": "total_validation_trade_count",
          "aggregation": "sum of block trade_count",
          "comparison": ">=",
          "threshold": "100"
        }
      ]
    },
    "parameter_neighbors": {
      "candidate_set": "every complete same-strategy and same-code-commit fixed-block identity whose parameters_json differs from the base identity in exactly one of short_lookback, long_lookback, selection_count, or rebalance_every",
      "required": "all query-selected one-parameter neighbors on all three fixed blocks",
      "metric": "parameter_neighbor_return_retention",
      "formula": "neighbor block total_return / base block total_return",
      "aggregation": "minimum across every query-selected neighbor and matching fixed block",
      "comparison": ">=",
      "threshold": "0.50",
      "substitution_after_results": false,
      "source_query": "config/research/rapid-003-parent-dispositions-v1.sql"
    },
    "execution_stress": {
      "range": "2020-07-27..2026-07-31",
      "required": "both scenarios",
      "scenarios": [
        {
          "id": "stress-a",
