          "gates": [
            {
              "metric": "stress_b_return",
              "comparison": ">",
              "threshold": "0"
            },
            {
              "metric": "stress_b_return_retention",
              "formula": "stress total_return / normal full-range total_return",
              "comparison": ">=",
              "threshold": "0.80"
            }
          ]
        }
      ]
    },
    "scope_note": "This exposed research screen uses the applicable daily base, neighbor, and combined-stress thresholds. Controlled-only regime-coverage, isolated-cost, isolated-delay, candidate-count, stored-plan, and authority gates were not evaluated here. Any survivor would still require a separately reviewed controlled plan and every unchanged controlled gate."
