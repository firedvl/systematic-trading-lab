{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/firedvl/systematic-trading-lab/config/research/program-007-unit-changing-action-ledger-v1.schema.json",
  "title": "Program 007 unit-changing action ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "program_id",
    "status",
    "schema_binding",
    "chronology",
    "normalization",
    "non_transformable_policy",
    "symbols",
    "actions",
    "historical_context",
    "evidence",
    "authority",
    "ledger_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "program-007-unit-changing-action-ledger-v1"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "program_id": {
      "const": "multi-hour-sector-etf-research-006"
    },
    "status": {
      "const": "PUBLIC-EVIDENCE-COMPLETE-NON-AUTHORIZING"
    },
    "schema_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "config/research/program-007-unit-changing-action-ledger-v1.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "chronology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_session", "end_session", "prehistory_rule"],
      "properties": {
        "start_session": {
          "const": "2020-06-26"
        },
        "end_session": {
          "const": "2026-07-31"
        },
        "prehistory_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "factor_representation",
        "effective_boundary",
        "prior_volume_rule",
        "same_session_price_rule",
        "same_session_return_proof",
        "raw_dollar_volume_proof",
        "reverse_split_rule",
        "multiple_action_rule"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "factor_representation": {
          "const": "exact Fraction new_shares/old_shares"
        },
        "effective_boundary": {
          "type": "string",
          "minLength": 1
        },
        "prior_volume_rule": {
          "type": "string",
          "minLength": 1
        },
        "same_session_price_rule": {
          "type": "string",
          "minLength": 1
        },
        "same_session_return_proof": {
          "type": "string",
          "minLength": 1
        },
        "raw_dollar_volume_proof": {
          "type": "string",
          "minLength": 1
        },
        "reverse_split_rule": {
          "type": "string",
          "minLength": 1
        },
        "multiple_action_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "non_transformable_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "action", "missingness_budget_can_override", "reason"],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "FAIL-DATASET-ADMISSION-BEFORE-STRATEGY"
        },
        "missingness_budget_can_override": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/symbolCoverage"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "historical_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historicalContext"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "ledger_fingerprint": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "symbol": {
      "enum": [
        "IWM",
        "MDY",
        "SPY",
        "XLB",
        "XLE",
        "XLF",
        "XLI",
        "XLK",
        "XLP",
        "XLRE",
        "XLU",
        "XLV",
        "XLY"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "symbolCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "fund_identity",
        "coverage_start",
        "coverage_end",
        "conclusion",
        "action_ids",
        "evidence_ids",
        "continuity_notes"
      ],
      "properties": {
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "fund_identity": {
          "type": "string",
          "minLength": 1
        },
        "coverage_start": {
          "const": "2020-06-26"
        },
        "coverage_end": {
          "const": "2026-07-31"
        },
        "conclusion": {
          "enum": [
            "APPLICABLE-ACTIONS-RECORDED",
            "NO-APPLICABLE-ACTION-FOUND"
          ]
        },
        "action_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "continuity_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "symbol",
        "fund_identity",
        "action_type",
        "announcement_date",
        "record_date",
        "payable_date",
        "effective_session",
        "effective_time_semantics",
        "old_shares",
        "new_shares",
        "transformable",
        "price_unit_effect",
        "share_volume_unit_effect",
        "normalization_rule",
        "affects_program_history",
        "evidence_ids"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "fund_identity": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "enum": ["forward_split", "reverse_split"]
        },
        "announcement_date": {
          "$ref": "#/$defs/date"
        },
        "record_date": {
          "$ref": "#/$defs/date"
        },
        "payable_date": {
          "$ref": "#/$defs/date"
        },
        "effective_session": {
          "$ref": "#/$defs/date"
        },
        "effective_time_semantics": {
          "type": "string",
          "minLength": 1
        },
        "old_shares": {
          "type": "integer",
          "minimum": 1
        },
        "new_shares": {
          "type": "integer",
          "minimum": 1
        },
        "transformable": {
          "const": true
        },
        "price_unit_effect": {
          "type": "string",
          "minLength": 1
        },
        "share_volume_unit_effect": {
          "type": "string",
          "minLength": 1
        },
        "normalization_rule": {
          "type": "string",
          "minLength": 1
        },
        "affects_program_history": {
          "type": "boolean"
        },
        "evidence_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "historicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "symbols",
        "effective_date",
        "classification",
        "description",
        "program_effect",
        "evidence_ids"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "symbols": {
          "$ref": "#/$defs/stringArray"
        },
        "effective_date": {
          "$ref": "#/$defs/date"
        },
        "classification": {
          "enum": ["OUTSIDE-CHRONOLOGY", "NON-UNIT-CHANGING"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "program_effect": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "classification",
        "title",
        "url",
        "retrieved_date",
        "supports"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "ISSUER-PRIMARY",
            "EXCHANGE-PRIMARY",
            "SEC-PRIMARY",
            "REGULATOR-PRIMARY"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "retrieved_date": {
          "$ref": "#/$defs/date"
        },
        "supports": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_contact",
        "subscription_purchase",
        "credential_access",
        "source_requests",
        "source_qualification",
        "market_data_acquisition",
        "real_dataset_admission",
        "strategy_implementation",
        "strategy_execution",
        "research_qualification",
        "controlled_evaluation",
        "protected_holdout",
        "paper_execution",
        "broker_writes",
        "live_execution"
      ],
      "properties": {
        "provider_contact": {"const": false},
        "subscription_purchase": {"const": false},
        "credential_access": {"const": false},
        "source_requests": {"const": false},
        "source_qualification": {"const": false},
        "market_data_acquisition": {"const": false},
        "real_dataset_admission": {"const": false},
        "strategy_implementation": {"const": false},
        "strategy_execution": {"const": false},
        "research_qualification": {"const": false},
        "controlled_evaluation": {"const": false},
        "protected_holdout": {"const": false},
        "paper_execution": {"const": false},
        "broker_writes": {"const": false},
        "live_execution": {"const": false}
      }
    }
  }
}
